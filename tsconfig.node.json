{
  "extends": "@vue/tsconfig/tsconfig.json",
  "include": [
    "vite.config.ts",
    "capacitor.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "tests/e2e/**/*"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "lib": ["ES2023", "DOM"],
    "types": ["node"],
    "noUncheckedIndexedAccess": true
  }
}
